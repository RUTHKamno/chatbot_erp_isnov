# Copy to .env.project for local application settings. Do not commit real secrets.
APP_NAME=Chatbot ERP Multi-Agent
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
FASTAPI_URL=http://localhost:8001

# Authentication
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_DATABASE_URL=
AUTH_DATABASE_HOST=127.0.0.1
AUTH_DATABASE_PORT=5433
DB_CRED_KEY=

# Hugging Face and audio
HF_TOKEN=
AUDIO_PROVIDER=hf
STT_MODEL_SIZE=small
STT_LANGUAGE=
STT_DEVICE=
STT_COMPUTE_TYPE=
TESSERACT_CMD=
TTS_ENGINE=melo

# Ollama models referenced by the application
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_LLM_GUIDE_ERP_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GUARD_MODEL=llama-guard3:8b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_VLM=qwen2.5vl:7b
BI_LLM_MODEL=qwen2.5-coder:7b

# Cube; CUBE_API_SECRET must match the Cube service configuration.
CUBE_API_SECRET=3dfea42a566996f37c5fdbe97f14749086a40e59fcd03f96a688782828bd5128

CUBE_API_URL=http://cube_semantic_layer:4000/cubejs-api/v1

CUBE_DEV_CONTEXT_URL=http://cube_semantic_layer:4001/dev/tenant-context

# Database, cache, storage and application options
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=replace_with_database_password
POSTGRES_DB=erp_dwh
DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=3600
CACHE_SIMILARITY_THRESHOLD=0.92
LANCEDB_URI=./data/lancedb
LANCEDB_TABLE=erp_knowledge
WREN_AI_SERVICE_URL=http://localhost:5555
WREN_UI_URL=http://localhost:3000
WREN_ENGINE_URL=http://localhost:8080
WREN_PROJECT_ID=
NEMO_GUARDRAILS_CONFIG_PATH=./app/guards/nemo_config
ENABLE_LLAMA_GUARD=true
ENABLE_SQL_INJECTION_FILTER=true
EVALUATOR_STRICT_MODE=true
ARTIFACTS_OUTPUT_DIR=./data/artifacts
ARTIFACTS_MAX_PPTX_SLIDES=20
LOG_LEVEL=INFO
ENABLE_DEBUG_TRACE=true
